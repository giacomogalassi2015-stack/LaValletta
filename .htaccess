boom# ============================================================
# .htaccess — Ca' della Valletta
# ============================================================

# ============================================================
# 1. REWRITE: FORZA HTTPS + WWW (301 permanente, SEO-safe)
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect a HTTPS se non già su HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Redirect a www se non già su www (separato per evitare loop)
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>


# ============================================================
# 2. CACHE DEL BROWSER
#    Expires: dice al browser per quanto tempo tenere il file
#    Cache-Control: rafforza la direttiva con header HTTP/1.1
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: nessuna cache (sempre fresco per SEO e aggiornamenti)
    ExpiresByType text/html                "access plus 0 seconds"

    # CSS e JS: 1 mese (aggiorna il nome file se cambi il contenuto)
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType text/javascript          "access plus 1 month"

    # Immagini: 1 anno (praticamente immutabili)
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/jpg                "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/avif               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Font: 1 anno
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType application/font-woff    "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"
</IfModule>

# Cache-Control esplicito (HTTP/1.1 — complementare a Expires)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>



# ============================================================
# 4. COMPRESSIONE GZIP (riduce il peso dei file di testo ~70%)
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>


# ============================================================
# 5. ERRORI PERSONALIZZATI (opzionale ma professionale)
# ============================================================
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html