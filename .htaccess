# ============================================================
# .htaccess — Ca' della Valletta
# ============================================================

# ============================================================
# 1. REWRITE: FORZA HTTPS + WWW (301 permanente, SEO-safe)
# ============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect a HTTPS se non già su HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Redirect a www se non già su www (separato per evitare loop)
    RewriteCond %{HTTP_HOST} !^www\. [NC]
    RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>


# ============================================================
# 2. CACHE DEL BROWSER
#    Expires: dice al browser per quanto tempo tenere il file
#    Cache-Control: rafforza la direttiva con header HTTP/1.1
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML: nessuna cache (sempre fresco per SEO e aggiornamenti)
    ExpiresByType text/html                "access plus 0 seconds"

    # CSS e JS: 1 mese (aggiorna il nome file se cambi il contenuto)
    ExpiresByType text/css                 "access plus 1 month"
    ExpiresByType application/javascript   "access plus 1 month"
    ExpiresByType text/javascript          "access plus 1 month"

    # Immagini: 1 anno (praticamente immutabili)
    ExpiresByType image/jpeg               "access plus 1 year"
    ExpiresByType image/jpg                "access plus 1 year"
    ExpiresByType image/png                "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 year"
    ExpiresByType image/avif               "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Font: 1 anno
    ExpiresByType font/woff                "access plus 1 year"
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType application/font-woff    "access plus 1 year"
    ExpiresByType application/font-woff2   "access plus 1 year"
</IfModule>

# Cache-Control esplicito (HTTP/1.1 — complementare a Expires)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>


# ============================================================
# 3. SICUREZZA — Headers HTTP
# ============================================================
<IfModule mod_headers.c>

    # ----------------------------------------------------------
    # HSTS: forza HTTPS per 1 anno su tutti i sottodomini
    # preload: iscrive il dominio nella lista preload dei browser
    # ATTENZIONE: una volta attivato è difficile da rimuovere
    # ----------------------------------------------------------
    Header always set Strict-Transport-Security \
        "max-age=31536000; includeSubDomains; preload"

    # ----------------------------------------------------------
    # Protezione base
    # ----------------------------------------------------------
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # ----------------------------------------------------------
    # Permissions Policy: disabilita feature non usate dal sito
    # Migliora il punteggio Observatory e la privacy utenti
    # ----------------------------------------------------------
    Header always set Permissions-Policy \
        "camera=(), microphone=(), geolocation=(), payment=(), usb=(), \
         fullscreen=(self), autoplay=()"

    # ----------------------------------------------------------
    # CONTENT SECURITY POLICY
    #
    # Servizi usati dal sito:
    #   script:  self, inline (AOS.init, booking widget), unpkg (AOS JS),
    #            npmcdn (flatpickr l10n), maps.googleapis
    #   style:   self, inline (critical CSS), fonts.googleapis,
    #            cdnjs (FontAwesome), unpkg (AOS CSS)
    #   img:     self, cloudinary (foto camere), wikimedia (loghi trust),
    #            maps.gstatic + googleapis (Google Maps tiles)
    #   font:    self, fonts.gstatic, cdnjs (FontAwesome woff2)
    #   frame:   google.com + maps.google.com (Maps embed lazy)
    #   connect: self, supabase (prezzi dinamici),
    #            ical.booking.com + ics.teamup.com (calendari)
    #   worker:  blob: (Supabase usa web workers interni)
    # ----------------------------------------------------------
    Header always set Content-Security-Policy \
        "default-src 'self'; \
         script-src 'self' 'unsafe-inline' \
             https://unpkg.com \
             https://npmcdn.com \
             https://maps.googleapis.com \
             https://maps.gstatic.com \
             https://cdnjs.cloudflare.com; \
         style-src 'self' 'unsafe-inline' \
             https://fonts.googleapis.com \
             https://cdnjs.cloudflare.com \
             https://unpkg.com \
             https://npmcdn.com; \
         img-src 'self' data: \
             https://res.cloudinary.com \
             https://upload.wikimedia.org \
             https://maps.gstatic.com \
             https://maps.googleapis.com \
             https://*.googleapis.com \
             https://*.gstatic.com; \
         font-src 'self' \
             https://fonts.gstatic.com \
             https://cdnjs.cloudflare.com; \
         frame-src 'self' \
             https://www.google.com \
             https://maps.google.com; \
         connect-src 'self' \
             https://qtvmrpzkvqsgzxlddsif.supabase.co \
             https://ical.booking.com \
             https://ics.teamup.com \
             https://maps.googleapis.com; \
         worker-src 'self' blob:; \
         base-uri 'self'; \
         form-action 'self';"

</IfModule>


# ============================================================
# 4. COMPRESSIONE GZIP (riduce il peso dei file di testo ~70%)
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>


# ============================================================
# 5. ERRORI PERSONALIZZATI (opzionale ma professionale)
# ============================================================
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html